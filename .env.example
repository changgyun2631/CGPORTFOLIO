# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋하지 않는다.

# 미국 상장 종목 시세 + USD/KRW 환율. 없으면 미국 종목 갱신이 건너뛰어진다.
# 무료 플랜은 하루 호출 수 제한이 있으므로 cron 주기를 넉넉히 잡을 것.
TWELVE_DATA_API_KEY=

# 로그인 계정. 값을 직접 만들지 말고 `npm run auth:setup`을 실행하면
# 비밀번호 원문을 저장하지 않고 아래 네 값을 .env.local에 기록한다.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# 예약 시세·주간 리포트 API 전용 토큰. production에서는 필수다.
CRON_SECRET=
