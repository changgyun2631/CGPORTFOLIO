# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 값이 비어 있는 설정 견본은 커밋한다. 실제 키가 든 .env.local 은 위 규칙으로 계속 제외된다.
!.env.example

# 개인 금융 데이터 — 저장소에 넣지 않는다.
#
# 한 번 커밋하면 git 이력에 영구히 남아서, 나중에 지워도 이력·포크·캐시에 그대로
# 남는다. 보유 종목·수량·평단·평가금액·계좌 잔고·입출금이 전부 이 파일들에 있다.
#
# 처음 받았다면 `node scripts/seed.mjs` 를 실행하면 data/sample 을 바탕으로
# 돌아가는 한 벌이 만들어진다.
/data/accounts.json
/data/symbols.json
/data/transactions.json
/data/cashflows.json
/data/dividends.json
/data/position-basis.json
/data/calendar.json
# cron 이 적재하는 시세·스냅샷. 여기에도 내 평가금액이 그대로 담긴다.
/data/snapshots.json
/data/quotes.json
/data/fx-quote.json
/data/prices.json
/data/prices-total-return.json
/data/fx.json
# 가져오기 스크립트의 검토용 출력에도 실제 계좌 데이터가 들어간다.
/data/out-*.json
# 예약 실행이 만드는 주간 리포트. 손으로 쓴 reports.json/reports/*.md 와 달리
# 그때그때의 실제 비중·평가금액이 본문에 들어간다.
/data/weekly-reports.json
# 원자적 쓰기가 남기는 이전 버전 백업과 쓰기 잠금 파일.
/data/*.bak
/data/.write.lock
# rename 직전에 죽으면 남는 임시 파일. 내용은 대상 파일과 같아서(=실제 계좌 데이터)
# 커밋되면 안 되는데, 이름이 매번 달라서 위 규칙에 안 걸린다.
/data/.*.tmp-*
# 워크트리에서 서버 액션(가져오기 등)을 테스트할 때 생기는 로컬 백업. 운영
# 백업 폴더(~/cgportfolio-backups/)와 분리하려고 cwd 안에 둔다(lib/import/paths.ts).
/.dev-backups

# 증권사에서 내려받은 원본 내역(잔고·계좌수익률·거래내역). 저장소 루트에 그대로
# 두고 가져오기를 돌리는 경우가 있어서, 화면 번호를 파일명으로 쓴 것까지 포함해
# 확장자로 막는다 — 안에 계좌 잔고와 보유 수량이 그대로 들어 있다.
/*.csv
/*.xlsx
/*.xls

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
